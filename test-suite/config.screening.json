{
  "schema_version": 1,
  "library_root": "..",
  "runs_root": "../runs/skillbench",
  "runtime": {
    "image": "research-library-skillbench:local",
    "provider": "zai",
    "model": "glm-5.3-flash",
    "base_url": "https://api.z.ai/api/coding/paas/v4",
    "thinking": "high",
    "context_window": 131072,
    "max_tokens": 8192,
    "api_key_env": "ZAI_API_KEY",
    "timeout_seconds": 240,
    "max_output_bytes": 8388608,
    "memory": "1g",
    "cpus": 1,
    "pids_limit": 128
  },
  "cases": [
    "jq-exact-text",
    "jq-reconcile-events",
    "tar-manifest-recovery",
    "sqlite-wal-export"
  ],
  "conditions": [
    "baseline",
    "current"
  ],
  "repetitions": 1,
  "seed": 1701,
  "selection": {
    "mode": "explicit",
    "catalog_size": 1,
    "distractors": "similar"
  },
  "budgets": {
    "max_trials": 8,
    "max_campaign_seconds": 2400,
    "max_total_tokens": null
  },
  "optimizer": {
    "endpoint": "https://api.z.ai/api/coding/paas/v4/chat/completions",
    "model": "glm-5.3-flash",
    "api_key_env": "ZAI_API_KEY",
    "max_tokens": 16384,
    "timeout_seconds": 180,
    "reasoning_effort": "low"
  }
}
